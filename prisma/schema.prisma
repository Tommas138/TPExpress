// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Exercise {
  id Int @id @default(autoincrement())
  difficulty String
  video String
  image String
  targetIntensity String
  @@map("exercise")
  translations ExerciseTranslation []
  favorite Favorites []
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExerciseTranslation {
  id Int @id @default(autoincrement())
  language String
  name String
  muscleGroup String
  equipment String
  breathing String
  technique String
  @@map("exerciseTranslation")
  exerciseId Int
  exercise Exercise @relation(fields: [exerciseId], references: [id])
}

model User {
  id        Int         @id @default(autoincrement())
  name      String
  email     String      @unique
  password  String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  favorites Favorites[] // Relación uno a muchos con favoritos

  @@map("users")
}

model Favorites {
  id         Int      @id @default(autoincrement())
  userId     Int      // Cambiado a Int para relacionarse con la ID de User
  exerciseId Int 
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@map("favorites")
  @@index([userId])
  @@index([exerciseId])
  @@unique([userId, exerciseId]) // Evita duplicados para un mismo usuario
}

model Routines {
  id Int @id @default(autoincrement())
  routineName String
  selectedDays Int
  cantRoutines Int
  @@map("routines")
}