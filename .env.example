# Variables de entorno de ejemplo
# No subir valores reales al repositorio

# URL de la base de datos (Postgres/Neon)
DATABASE_URL=

# Puerto en el que corre la API (por defecto para desarrollo)
PORT=3000

# Orígenes permitidos para el frontend (separar múltiples con comas)
# Ejemplo: http://localhost:5173,https://pwa-tp-2-k63n.vercel.app
FRONTEND_URL=http://localhost:5173

# Entorno de ejecución
NODE_ENV=development
